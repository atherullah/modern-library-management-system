PORT=PORT_NUMBER
DB_URL=ENTER_YOUR_MONGODB_URL
JWT_PRIVATE_KEY=ENTER_YOUR_UNIQUE_JWT_PRIVATE_KEY

# Real SMTP Email Configuration (100% Free - Brevo/Sendinblue Recommended)
# 1. Sign up for a free account at Brevo.com (300 free emails per day, no credit card required)
# 2. Retrieve your SMTP credentials from your Brevo dashboard under 'SMTP & API'
# 3. Fill in the values below to send real, inbox-delivered emails to your users:
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_registered_email@example.com
EMAIL_PASS=your_brevo_smtp_master_password_or_key
EMAIL_FROM=Alvin's Library Portal <your_brevo_registered_email@example.com>

# Alternative: Gmail with App Password
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=your-gmail-app-password
# EMAIL_FROM=Alvin's Library Portal <your@gmail.com>

# Groq AI Chatbot (free tier — console.groq.com)
GROQ_API_KEY=your-groq-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
