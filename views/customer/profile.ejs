<div class="container my-4">
<%- include('../partials/flash-toast') %>

  <!-- Profile header -->
  <div class="card shadow-sm mb-4">
    <div class="card-body d-flex flex-column flex-md-row align-items-center gap-3">
      <img src="<%= user.profilePicturePath %>" alt="<%= user.name %>" class="rounded-circle border" width="96" height="96" style="object-fit:cover;">
      <div class="text-center text-md-start flex-grow-1">
        <h2 class="mb-0"><%= user.name %></h2>
        <p class="text-muted mb-1"><%= user.email %></p>
        <p class="text-muted small mb-0">Member since <%= new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'long', day: '2-digit' }).format(user.created_at) %></p>
      </div>
      <a href="/profile/edit" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Edit Profile</a>
    </div>
  </div>

  <!-- Stat cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="card text-center h-100"><div class="card-body">
        <i class="bi bi-journal-bookmark-fill fs-2 text-primary"></i>
        <div class="display-6 fw-bold"><%= stats.currentCount %></div>
        <div class="text-muted small">Currently borrowed</div>
      </div></div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card text-center h-100"><div class="card-body">
        <i class="bi bi-collection-fill fs-2 text-success"></i>
        <div class="display-6 fw-bold"><%= stats.totalBorrowed %></div>
        <div class="text-muted small">Total borrowed</div>
      </div></div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card text-center h-100"><div class="card-body">
        <i class="bi bi-star-fill fs-2 text-warning"></i>
        <div class="display-6 fw-bold"><%= stats.reviewCount %></div>
        <div class="text-muted small">Reviews written</div>
      </div></div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card text-center h-100 <%= outstandingFines > 0 ? 'border-danger' : '' %>"><div class="card-body">
        <i class="bi bi-cash-coin fs-2 <%= outstandingFines > 0 ? 'text-danger' : 'text-muted' %>"></i>
        <div class="display-6 fw-bold"><%= settings.currency_symbol %><%= outstandingFines.toFixed(2) %></div>
        <div class="text-muted small">Outstanding fines</div>
      </div></div>
    </div>
  </div>

  <% if (outstandingFines > 0) { %>
    <div class="alert alert-warning d-flex align-items-center" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      <div>You have <strong><%= settings.currency_symbol %><%= outstandingFines.toFixed(2) %></strong> in unpaid fines. Please settle them at the library desk.</div>
    </div>
  <% } %>

  <!-- Current loans -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white"><h5 class="mb-0"><i class="bi bi-journal-arrow-up"></i> Current Loans</h5></div>
    <div class="card-body">
      <% if (currentLoans && currentLoans.length > 0) { %>
        <div class="list-group list-group-flush">
          <% currentLoans.forEach(loan => { %>
            <% if (loan.borrowed_book) { %>
              <%
                const now = new Date()
                const due = new Date(loan.return_date)
                const days = Math.ceil((due - now) / (1000 * 60 * 60 * 24))
                let badge, label
                if (days < 0) { badge = 'bg-danger'; label = 'Overdue by ' + Math.abs(days) + ' day' + (Math.abs(days) === 1 ? '' : 's') }
                else if (days === 0) { badge = 'bg-warning text-dark'; label = 'Due today' }
                else if (days <= 3) { badge = 'bg-warning text-dark'; label = 'Due in ' + days + ' day' + (days === 1 ? '' : 's') }
                else { badge = 'bg-success'; label = 'Due in ' + days + ' days' }
              %>
              <div class="list-group-item d-flex align-items-center gap-3 px-0 flex-wrap">
                <img src="<%= loan.borrowed_book.coverImagePath %>" alt="" width="44" height="60" style="object-fit:cover;border-radius:4px;">
                <div class="flex-grow-1" style="min-width:150px;">
                  <a href="/book/<%= loan.borrowed_book.id %>" class="fw-semibold text-reset text-decoration-none"><%= loan.borrowed_book.title %></a>
                  <div class="small text-muted">Due <%= new Date(loan.return_date).toLocaleDateString() %></div>
                </div>
                <span class="badge <%= badge %>"><%= label %></span>
                <form action="/return" method="POST" class="m-0" data-confirm="Return this book now?">
                  <input type="hidden" name="user_id" value="<%= user.id %>">
                  <input type="hidden" name="book_id" value="<%= loan.borrowed_book.id %>">
                  <input type="hidden" name="history_id" value="<%= loan.id %>">
                  <button class="btn btn-sm btn-outline-primary" type="submit">Return</button>
                </form>
              </div>
            <% } %>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-muted mb-0">You have no books out on loan. <a href="/books">Browse the catalog &rarr;</a></p>
      <% } %>
    </div>
  </div>

  <!-- Reservations -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white"><h5 class="mb-0"><i class="bi bi-clock-history"></i> My Reservations</h5></div>
    <div class="card-body">
      <% if (typeof reservations !== 'undefined' && reservations.length > 0) { %>
        <div class="list-group list-group-flush">
          <% reservations.forEach(reservation => { %>
            <% if (reservation.book) { %>
              <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                <div class="d-flex align-items-center gap-3">
                  <img src="<%= reservation.book.coverImagePath %>" alt="" width="44" height="60" style="object-fit:cover;border-radius:4px;">
                  <div>
                    <a href="/book/<%= reservation.book._id %>" class="fw-semibold text-reset text-decoration-none"><%= reservation.book.title %></a>
                    <div class="small text-muted">Reserved <%= new Date(reservation.createdAt).toLocaleDateString() %></div>
                  </div>
                </div>
                <% const s = reservation.status; const sb = s === 'Pending' ? 'bg-warning text-dark' : (s === 'Fulfilled' ? 'bg-success' : 'bg-secondary') %>
                <span class="badge <%= sb %>"><%= s %></span>
              </div>
            <% } %>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-muted mb-0">You don't have any reservations at the moment.</p>
      <% } %>
    </div>
  </div>

  <!-- Quick links -->
  <div class="d-flex flex-wrap gap-2 mb-5">
    <a href="/wishlist" class="btn btn-outline-danger"><i class="bi bi-heart"></i> Wishlist (<%= stats.wishlistCount %>)</a>
    <a href="/history/<%= user.id %>" class="btn btn-outline-secondary"><i class="bi bi-clock-history"></i> Borrow History</a>
    <a href="/inventory/<%= user.id %>" class="btn btn-outline-secondary"><i class="bi bi-journal-bookmark"></i> My Inventory</a>
    <a href="/books" class="btn btn-outline-primary"><i class="bi bi-collection"></i> Browse Books</a>
  </div>
</div>
