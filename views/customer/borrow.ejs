<div class="container my-5">
  <h1 class="h2 mb-4"><i class="bi bi-journal-arrow-down"></i> Borrow Books</h1>

  <% if (!cartItems || cartItems.length === 0) { %>
    <div class="text-center py-5 bg-light border rounded-3">
      <i class="bi bi-cart-x" style="font-size:3rem;color:#adb5bd;"></i>
      <h4 class="mt-3">Nothing to borrow</h4>
      <p class="text-muted mb-3">Your cart is empty — add some books first.</p>
      <a href="/books" class="btn btn-primary"><i class="bi bi-collection"></i> Browse books</a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <!-- Books being borrowed -->
      <div class="col-lg-7">
        <div class="card shadow-sm">
          <div class="card-header bg-white fw-semibold"><%= cartItems.length %> book<%= cartItems.length === 1 ? '' : 's' %> to borrow</div>
          <ul class="list-group list-group-flush">
            <% cartItems.forEach(item => { %>
              <% if (item.book) { %>
                <li class="list-group-item d-flex align-items-center gap-3 py-3">
                  <img src="<%= item.book.coverImagePath %>" alt="<%= item.book.title %>" width="48" height="68" style="object-fit:cover;border-radius:4px;">
                  <div class="flex-grow-1" style="min-width:0;">
                    <span class="fw-semibold d-block text-truncate"><%= item.book.title %></span>
                    <span class="small text-muted">by <%= item.book.author %></span>
                  </div>
                  <% if (item.book.stock === 0) { %><span class="badge bg-danger">Out of stock</span><% } %>
                </li>
              <% } %>
            <% }) %>
          </ul>
        </div>
      </div>

      <!-- Loan details -->
      <div class="col-lg-5">
        <div class="card shadow-sm">
          <div class="card-header bg-white fw-semibold">Loan Details</div>
          <div class="card-body">
            <form action="/borrow" method="POST">
              <input type="hidden" name="user_id" value="<%= user.id %>">
              <div class="mb-3">
                <label for="borrowDate" class="form-label">Borrow Date</label>
                <input type="date" class="form-control" id="borrowDate" name="borrowDate" readonly>
              </div>
              <div class="mb-2">
                <label for="returnDate" class="form-label">Return Date</label>
                <input type="date" class="form-control" id="returnDate" name="returnDate" required>
              </div>
              <div id="loan-hint" class="form-text mb-3"><i class="bi bi-info-circle"></i> Loans run 1–30 days. Default is 14 days.</div>
              <% if (typeof errors !== 'undefined') { %>
                <% errors.forEach(err => { %>
                  <% if (err.param === 'returnDate') { %>
                    <div class="alert alert-danger py-2 small mb-3"><%= err.msg %></div>
                  <% } %>
                <% }) %>
              <% } %>
              <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i> Confirm Borrow</button>
                <a href="/cart" class="btn btn-outline-secondary">Back to Cart</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script>
  (function () {
    const fmt = (d) => {
      const z = (n) => String(n).padStart(2, '0')
      return d.getFullYear() + '-' + z(d.getMonth() + 1) + '-' + z(d.getDate())
    }
    const borrow = document.getElementById('borrowDate')
    const ret = document.getElementById('returnDate')
    const hint = document.getElementById('loan-hint')
    if (!borrow || !ret) return

    const today = new Date()
    const addDays = (n) => { const d = new Date(today); d.setDate(d.getDate() + n); return d }

    borrow.value = fmt(today)
    ret.min = fmt(addDays(1))    // at least 1 day
    ret.max = fmt(addDays(30))   // at most 30 days (matches server validation)
    if (!ret.value) ret.value = fmt(addDays(14)) // sensible default

    function updateHint() {
      if (!hint) return
      if (!ret.value) { hint.innerHTML = '<i class="bi bi-info-circle"></i> Loans run 1–30 days.'; return }
      const days = Math.round((new Date(ret.value) - new Date(borrow.value)) / (1000 * 60 * 60 * 24))
      const due = new Date(ret.value)
      hint.innerHTML = '<i class="bi bi-calendar-check"></i> Loan period: <strong>' + days + ' day' + (days === 1 ? '' : 's') +
        '</strong> &middot; Due <strong>' + due.toLocaleDateString() + '</strong>'
    }
    ret.addEventListener('change', updateHint)
    updateHint()
  })()
</script>