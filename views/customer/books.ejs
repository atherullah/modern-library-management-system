<div class="display-5 text-center my-5">All Books</div>
<div class="container">
<%- include('../partials/flash-toast') %>

  <%- include('../partials/book-filters', { filterAction: '/books', showSearch: true }) %>

  <p class="text-muted small mb-3">
    <%= totalBook %> book<%= totalBook === 1 ? '' : 's' %> found<% if (typeof q !== 'undefined' && q) { %> for "<strong><%= q %></strong>"<% } %>
  </p>

  <% if (typeof books !== 'undefined' && books.length > 0) { %>
    <div class="row d-flex justify-content-center">
      <% books.forEach(book => { %>
        <div class="col-lg-2 col-md-4 col-sm-6 col-xs-3 my-2" style="width: 12rem;">
          <%- include('../partials/book-card', { book: book, rating: (typeof ratings !== 'undefined' ? ratings[book.id] : null), prevUrl: '/books' }) %>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="text-center py-5">
      <i class="bi bi-search" style="font-size:2.5rem;color:#adb5bd;"></i>
      <p class="lead text-muted mt-3 mb-1">No books match your search.</p>
      <a href="/books" class="btn btn-outline-secondary btn-sm mt-2">Clear filters</a>
    </div>
  <% } %>
</div>

<!-- Pagination -->
<div class="mb-4">
  <% const fq = typeof filterQuery !== 'undefined' ? filterQuery : '' %>
  <% if (totalPage > 0) { %>
    <ul class="pagination justify-content-center mt-5">
      <% if (currentPage === 1) { %>
        <li class="page-item disabled">
          <a class="page-link">First</a>
        </li>
      <% } else { %>
        <li class="page-item">
          <a class="page-link" href="/books/1<%= fq %>">First</a>
        </li>
      <% } %>
      <% let i = (currentPage > 5 ? currentPage - 4 : 1) %>
      <% if (i !== 1) { %>
        <li class="page-item disabled">
          <a class="page-link">...</a>
        </li>
      <% } %>
      <% for (; i <= currentPage + 4 && i <= totalPage; i++) { %>
        <% if (i === currentPage) { %>
          <li class="page-item active">
            <a class="page-link"><%= i %></a>
          </li>
        <% } else { %>
          <li class="page-item">
            <a class="page-link" href="/books/<%= i %><%= fq %>"><%= i %></a>
          </li>
        <% } %>
        <% if (i == currentPage + 4 && i < totalPage) { %>
          <li class="page-item disabled">
            <a class="page-link">...</a>
          </li>
        <% } %>
      <% } %>
      <% if (currentPage === totalPage) { %>
        <li class="page-item disabled">
          <a class="page-link">Last</a>
        </li>
      <% } else { %>
        <li class="page-item">
          <a class="page-link" href="/books/<%= totalPage %><%= fq %>">Last</a>
        </li>
      <% } %>
    </ul>
  <% } %>
</div>

