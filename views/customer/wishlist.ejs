<div class="container my-5">
  <h2 class="mb-4"><i class="bi bi-heart-fill text-danger"></i> My Wishlist</h2>

  <% if (msg && msg.length !== 0) { %>
    <div class="alert alert-info fw-bold py-2 text-center" role="alert">
      <%= msg %>
    </div>
  <% } %>

  <% if (items.length === 0) { %>
    <div class="alert alert-light border text-center py-5">
      <i class="bi bi-heart display-4 text-muted d-block mb-3"></i>
      <p class="lead text-muted mb-3">Your wishlist is empty.</p>
      <a href="/books" class="btn btn-danger">Browse Books</a>
    </div>
  <% } else { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% items.forEach(item => { %>
        <div class="col">
          <div class="card h-100 shadow-sm border-0">
            <div class="row g-0 h-100">
              <div class="col-4">
                <a href="/book/<%= item.book._id %>">
                  <img src="<%= item.book.coverImagePath %>" class="img-fluid rounded-start h-100" alt="<%= item.book.title %>" style="object-fit: cover; max-height: 180px; width: 100%;">
                </a>
              </div>
              <div class="col-8 d-flex flex-column">
                <div class="card-body flex-grow-1">
                  <h6 class="card-title mb-1">
                    <a href="/book/<%= item.book._id %>" class="text-decoration-none text-dark fw-bold"><%= item.book.title %></a>
                  </h6>
                  <p class="card-text text-muted small mb-2"><%= item.book.author %></p>
                  <% if (item.book.stock > 0) { %>
                    <span class="badge bg-success">In Stock</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Out of Stock</span>
                  <% } %>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3 d-flex gap-2">
                  <% if (item.book.stock > 0) { %>
                    <form action="/cart" method="POST">
                      <input type="hidden" name="user_id" value="<%= user.id %>">
                      <input type="hidden" name="book_id" value="<%= item.book._id %>">
                      <input type="hidden" name="prev_url" value="/wishlist">
                      <button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-cart-plus"></i> Cart</button>
                    </form>
                  <% } %>
                  <form action="/wishlist?_method=DELETE" method="POST">
                    <input type="hidden" name="item_id" value="<%= item._id %>">
                    <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i> Remove</button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
