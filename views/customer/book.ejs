<div class="container my-5">
<%- include('../partials/flash-toast') %>

  <div class="row">
    <!-- Book Image -->
    <div class="col-md-4 text-center mb-4">
      <img src="<%= book.coverImagePath %>" class="img-fluid rounded border shadow-sm" alt="<%= book.title %>" style="max-height: 500px;">
    </div>
    
    <!-- Book Details -->
    <div class="col-md-8">
      <h1 class="display-5 mb-2"><%= book.title %> (<%= book.publish_year %>)</h1>
      <h4 class="text-muted mb-3">by <%= book.author %></h4>
      
      <div class="mb-4">
        <span class="badge bg-primary fs-6 me-2 p-2">
          &#9733; <%= averageRating > 0 ? averageRating : 'No ratings yet' %>
        </span>
        <span class="text-muted"><%= reviews.length %> review(s)</span>
      </div>

      <ul class="list-group list-group-flush mb-4 fs-5">
         <li class="list-group-item bg-transparent px-0"><strong>Categories:</strong> <%= book.categories ? book.categories.join(', ') : '' %></li>
         <li class="list-group-item bg-transparent px-0"><strong>ISBN:</strong> <%= book.isbn %></li>
         <li class="list-group-item bg-transparent px-0"><strong>Pages:</strong> <%= book.page_count %></li>
         <li class="list-group-item bg-transparent px-0"><strong>Stock Availability:</strong> 
            <% if (book.stock > 0) { %>
              <span class="text-success fw-bold"><%= book.stock %> in stock</span>
            <% } else { %>
              <span class="text-danger fw-bold">Out of stock</span>
            <% } %>
         </li>
      </ul>

      <h5 class="fw-bold">Description</h5>
      <p class="lead fs-6" style="white-space: pre-line;"><%= book.description %></p>

      <div class="mt-4 d-flex flex-wrap gap-2">
        <% if (book.stock > 0) { %>
          <form class="d-inline-block js-action-form" action="/cart" method="POST">
            <% if (user) { %>
              <input type="hidden" name="user_id" value="<%= user.id %>">
            <% } %>
            <input type="hidden" name="book_id" value="<%= book.id %>">
            <input type="hidden" name="prev_url" value="/book/<%= book.id %>">
            <button class="btn btn-primary btn-lg px-4" type="submit"><i class="bi bi-cart-plus"></i> Add to Cart</button>
          </form>
        <% } else { %>
          <form class="d-inline-block" action="/book/<%= book.id %>/reserve" method="POST">
            <% if (user) { %>
              <input type="hidden" name="user_id" value="<%= user.id %>">
            <% } %>
            <button class="btn btn-warning btn-lg px-4" type="submit"><i class="bi bi-clock-history"></i> Reserve Book</button>
          </form>
        <% } %>
        <% if (user) { %>
          <form class="d-inline-block js-action-form" action="/wishlist" method="POST">
            <input type="hidden" name="user_id" value="<%= user.id %>">
            <input type="hidden" name="book_id" value="<%= book.id %>">
            <input type="hidden" name="prev_url" value="/book/<%= book.id %>">
            <button class="btn btn-outline-danger btn-lg px-4" type="submit"><i class="bi bi-heart"></i> Wishlist</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <hr class="my-5">

  <!-- Reviews Section -->
  <div class="row">
    <div class="col-md-8 mx-auto">
      <h3 class="mb-4"><i class="bi bi-chat-left-text"></i> Customer Reviews</h3>
      
      <!-- Review Form -->
      <% if (user) { %>
        <div class="card bg-light mb-5 border-0 shadow-sm">
          <div class="card-body">
            <h5 class="card-title mb-3">Write a review</h5>
            <form action="/book/<%= book.id %>/review" method="POST">
              <input type="hidden" name="user_id" value="<%= user.id %>">
              
              <div class="mb-3">
                <label class="form-label fw-bold d-block">Rating</label>
                <div class="star-rating" role="radiogroup" aria-label="Star rating">
                  <input type="radio" id="star5" name="rating" value="5" required>
                  <label for="star5" title="Excellent" aria-label="5 stars"><i class="bi bi-star-fill"></i></label>
                  <input type="radio" id="star4" name="rating" value="4">
                  <label for="star4" title="Very Good" aria-label="4 stars"><i class="bi bi-star-fill"></i></label>
                  <input type="radio" id="star3" name="rating" value="3">
                  <label for="star3" title="Good" aria-label="3 stars"><i class="bi bi-star-fill"></i></label>
                  <input type="radio" id="star2" name="rating" value="2">
                  <label for="star2" title="Fair" aria-label="2 stars"><i class="bi bi-star-fill"></i></label>
                  <input type="radio" id="star1" name="rating" value="1">
                  <label for="star1" title="Poor" aria-label="1 star"><i class="bi bi-star-fill"></i></label>
                </div>
              </div>
              
              <div class="mb-3">
                <label class="form-label fw-bold">Comment</label>
                <textarea class="form-control" name="comment" rows="3" placeholder="What did you think about this book?" required></textarea>
              </div>
              
              <button type="submit" class="btn btn-primary">Submit Review</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <div class="alert alert-secondary text-center mb-5">
          <a href="/login" class="alert-link text-decoration-none">Log in</a> to leave a review.
        </div>
      <% } %>

      <!-- Review List -->
      <% if (reviews.length > 0) { %>
        <% reviews.forEach(review => { %>
          <div class="card mb-3 border-0 shadow-sm">
            <div class="card-body d-flex">
              <div class="me-3">
                <img src="<%= review.user.profilePicturePath %>" alt="avatar" class="rounded-circle" width="50" height="50" style="object-fit: cover;">
              </div>
              <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <h6 class="mb-0 fw-bold"><%= review.user.name %></h6>
                  <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString() %></small>
                </div>
                <div class="mb-2 text-warning">
                   <% for(let i=1; i<=5; i++) { %>
                     <% if(i <= review.rating) { %> &#9733; <% } else { %> &#9734; <% } %>
                   <% } %>
                </div>
                <p class="mb-0"><%= review.comment %></p>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-muted fs-5">There are no reviews yet. Be the first to review this book!</p>
      <% } %>
    </div>
  </div>

  <!-- Recommendations -->
  <% if ((typeof moreByAuthor !== 'undefined' && moreByAuthor.length) || (typeof alsoBorrowed !== 'undefined' && alsoBorrowed.length)) { %>
    <hr class="my-5">
    <% if (typeof moreByAuthor !== 'undefined' && moreByAuthor.length) { %>
      <section class="mb-5">
        <h3 class="mb-3"><i class="bi bi-person-lines-fill"></i> More by <%= book.author %></h3>
        <div class="row g-3 justify-content-center justify-content-md-start">
          <% moreByAuthor.forEach(b => { %>
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
              <%- include('../partials/book-card', { book: b, rating: recRatings[b.id], prevUrl: '/book/' + book.id }) %>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>
    <% if (typeof alsoBorrowed !== 'undefined' && alsoBorrowed.length) { %>
      <section class="mb-5">
        <h3 class="mb-3"><i class="bi bi-people-fill"></i> Readers also enjoyed</h3>
        <div class="row g-3 justify-content-center justify-content-md-start">
          <% alsoBorrowed.forEach(b => { %>
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
              <%- include('../partials/book-card', { book: b, rating: recRatings[b.id], prevUrl: '/book/' + book.id }) %>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>
  <% } %>
</div>
