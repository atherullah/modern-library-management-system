<div class="container my-5">
  <% if (msg && msg.length !== 0) { %>
    <div class="alert alert-info fw-bold py-2 text-center" role="alert">
      <%= msg %>
    </div>
  <% } %>

  <div class="row">
    <!-- Book Image -->
    <div class="col-md-4 text-center mb-4">
      <img src="<%= book.coverImagePath %>" class="img-fluid rounded border shadow-sm" alt="<%= book.title %>" style="max-height: 500px;">
    </div>
    
    <!-- Book Details -->
    <div class="col-md-8">
      <h1 class="display-5 mb-2"><%= book.title %> (<%= book.publish_year %>)</h1>
      <h4 class="text-muted mb-3">by <%= book.author %></h4>
      
      <div class="mb-4">
        <span class="badge bg-primary fs-6 me-2 p-2">
          &#9733; <%= averageRating > 0 ? averageRating : 'No ratings yet' %>
        </span>
        <span class="text-muted"><%= reviews.length %> review(s)</span>
      </div>

      <ul class="list-group list-group-flush mb-4 fs-5">
         <li class="list-group-item bg-transparent px-0"><strong>Categories:</strong> <%= book.categories ? book.categories.join(', ') : '' %></li>
         <li class="list-group-item bg-transparent px-0"><strong>ISBN:</strong> <%= book.isbn %></li>
         <li class="list-group-item bg-transparent px-0"><strong>Pages:</strong> <%= book.page_count %></li>
         <li class="list-group-item bg-transparent px-0"><strong>Stock Availability:</strong> 
            <% if (book.stock > 0) { %>
              <span class="text-success fw-bold"><%= book.stock %> in stock</span>
            <% } else { %>
              <span class="text-danger fw-bold">Out of stock</span>
            <% } %>
         </li>
      </ul>

      <h5 class="fw-bold">Description</h5>
      <p class="lead fs-6" style="white-space: pre-line;"><%= book.description %></p>

      <div class="mt-4">
        <% if (book.stock > 0) { %>
          <form class="d-inline-block" action="/cart" method="POST">
            <% if (user) { %>
              <input type="hidden" name="user_id" value="<%= user.id %>">
            <% } %>
            <input type="hidden" name="book_id" value="<%= book.id %>">
            <input type="hidden" name="prev_url" value="/book/<%= book.id %>">
            <button class="btn btn-primary btn-lg px-4" type="submit"><i class="bi bi-cart-plus"></i> Add to Cart</button>
          </form>
        <% } else { %>
          <form class="d-inline-block" action="/book/<%= book.id %>/reserve" method="POST">
            <% if (user) { %>
              <input type="hidden" name="user_id" value="<%= user.id %>">
            <% } %>
            <button class="btn btn-warning btn-lg px-4" type="submit"><i class="bi bi-clock-history"></i> Reserve Book</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <hr class="my-5">

  <!-- Reviews Section -->
  <div class="row">
    <div class="col-md-8 mx-auto">
      <h3 class="mb-4"><i class="bi bi-chat-left-text"></i> Customer Reviews</h3>
      
      <!-- Review Form -->
      <% if (user) { %>
        <div class="card bg-light mb-5 border-0 shadow-sm">
          <div class="card-body">
            <h5 class="card-title mb-3">Write a review</h5>
            <form action="/book/<%= book.id %>/review" method="POST">
              <input type="hidden" name="user_id" value="<%= user.id %>">
              
              <div class="mb-3">
                <label class="form-label fw-bold">Rating</label>
                <select class="form-select w-auto" name="rating" required>
                  <option value="5">5 - Excellent</option>
                  <option value="4">4 - Very Good</option>
                  <option value="3">3 - Good</option>
                  <option value="2">2 - Fair</option>
                  <option value="1">1 - Poor</option>
                </select>
              </div>
              
              <div class="mb-3">
                <label class="form-label fw-bold">Comment</label>
                <textarea class="form-control" name="comment" rows="3" placeholder="What did you think about this book?" required></textarea>
              </div>
              
              <button type="submit" class="btn btn-dark">Submit Review</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <div class="alert alert-secondary text-center mb-5">
          <a href="/login" class="alert-link text-decoration-none">Log in</a> to leave a review.
        </div>
      <% } %>

      <!-- Review List -->
      <% if (reviews.length > 0) { %>
        <% reviews.forEach(review => { %>
          <div class="card mb-3 border-0 shadow-sm">
            <div class="card-body d-flex">
              <div class="me-3">
                <img src="/images/profiles/<%= review.user.profile_picture %>" alt="avatar" class="rounded-circle" width="50" height="50" style="object-fit: cover;">
              </div>
              <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <h6 class="mb-0 fw-bold"><%= review.user.name %></h6>
                  <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString() %></small>
                </div>
                <div class="mb-2 text-warning">
                   <% for(let i=1; i<=5; i++) { %>
                     <% if(i <= review.rating) { %> &#9733; <% } else { %> &#9734; <% } %>
                   <% } %>
                </div>
                <p class="mb-0"><%= review.comment %></p>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-muted fs-5">There are no reviews yet. Be the first to review this book!</p>
      <% } %>
    </div>
  </div>
</div>
