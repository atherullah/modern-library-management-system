<div class="container my-5">
  <%- include('../partials/flash-toast') %>

  <h1 class="h2 mb-4"><i class="bi bi-cart3"></i> My Cart</h1>

  <% if (!cartItems || cartItems.length === 0) { %>
    <!-- Empty state -->
    <div class="text-center py-5 bg-light border rounded-3">
      <i class="bi bi-cart-x" style="font-size:3rem;color:#adb5bd;"></i>
      <h4 class="mt-3">Your cart is empty</h4>
      <p class="text-muted mb-3">Browse the catalogue and add the books you'd like to borrow.</p>
      <a href="/books" class="btn btn-primary"><i class="bi bi-collection"></i> Browse books</a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <!-- Line items -->
      <div class="col-lg-8">
        <div class="card shadow-sm">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><%= cartItems.length %> item<%= cartItems.length === 1 ? '' : 's' %> in your cart</span>
            <a href="/books" class="btn btn-sm btn-outline-secondary"><i class="bi bi-plus-lg"></i> Add more</a>
          </div>
          <ul class="list-group list-group-flush">
            <% cartItems.forEach(item => { %>
              <% if (item.book) { %>
                <li class="list-group-item d-flex align-items-center gap-3 py-3">
                  <a href="/book/<%= item.book.id %>" class="flex-shrink-0">
                    <img src="<%= item.book.coverImagePath %>" alt="<%= item.book.title %>" width="56" height="80" style="object-fit:cover;border-radius:4px;">
                  </a>
                  <div class="flex-grow-1" style="min-width:0;">
                    <a href="/book/<%= item.book.id %>" class="fw-semibold text-reset text-decoration-none d-block text-truncate"><%= item.book.title %></a>
                    <div class="small text-muted text-truncate">by <%= item.book.author %></div>
                    <div class="mt-1">
                      <% if (item.book.stock > 0) { %>
                        <span class="badge bg-success">In stock</span>
                      <% } else { %>
                        <span class="badge bg-danger">Out of stock</span>
                      <% } %>
                    </div>
                  </div>
                  <form action="/cart?_method=DELETE" method="POST" class="m-0" data-confirm="Remove this book from your cart?">
                    <input type="hidden" name="item_id" value="<%= item._id %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove" aria-label="Remove from cart"><i class="bi bi-trash"></i></button>
                  </form>
                </li>
              <% } %>
            <% }) %>
          </ul>
        </div>
      </div>

      <!-- Summary -->
      <div class="col-lg-4">
        <div class="card shadow-sm">
          <div class="card-header bg-white fw-semibold">Borrow Summary</div>
          <div class="card-body">
            <div class="d-flex justify-content-between mb-3">
              <span class="text-muted">Total items</span>
              <span class="fw-semibold"><%= cartItems.length %></span>
            </div>
            <% if (typeof outOfStock !== 'undefined' && outOfStock) { %>
              <div class="alert alert-warning small d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div>Please remove out-of-stock items before borrowing.</div>
              </div>
            <% } %>
            <div class="d-grid gap-2">
              <% if (typeof outOfStock !== 'undefined' && outOfStock) { %>
                <button class="btn btn-primary" type="button" disabled><i class="bi bi-journal-arrow-down"></i> Proceed to borrow</button>
              <% } else { %>
                <a href="/borrow" class="btn btn-primary"><i class="bi bi-journal-arrow-down"></i> Proceed to borrow</a>
              <% } %>
              <a href="/books" class="btn btn-outline-secondary">Continue browsing</a>
            </div>
          </div>
        </div>
        <p class="text-muted small text-center mt-3 mb-0"><i class="bi bi-shield-check"></i> Loans are free &mdash; just return on time.</p>
      </div>
    </div>
  <% } %>
</div>
