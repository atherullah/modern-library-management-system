<!-- Carousel -->
<div id="carouselCaptions" class="carousel slide hero-carousel" data-bs-ride="carousel">
  <div class="carousel-indicators">
    <button type="button" data-bs-target="#carouselCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
    <button type="button" data-bs-target="#carouselCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
    <button type="button" data-bs-target="#carouselCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
    <button type="button" data-bs-target="#carouselCaptions" data-bs-slide-to="3" aria-label="Slide 4"></button>
  </div>
  <div class="carousel-inner">
    <div class="carousel-item active" data-bs-interval="5000">
      <img src="/public/assets/hero-shelves.jpg" class="d-block w-100 carousel-img" alt="Wall of books with a wooden library ladder">
      <div class="carousel-caption text-start">
        <h2 class="fw-bold">Discover your next great read</h2>
        <p class="d-none d-md-block">Thousands of titles across every genre — browse, borrow, and enjoy.</p>
        <a href="/books" class="btn btn-light btn-lg mt-2"><i class="bi bi-collection"></i> Browse the catalog</a>
      </div>
    </div>
    <div class="carousel-item" data-bs-interval="5000">
      <img src="/public/assets/hero-stairs.jpg" class="d-block w-100 carousel-img" alt="Cosy, warmly-lit library with colourful book-lined stairs">
      <div class="carousel-caption text-start">
        <h2 class="fw-bold">A cosy corner for every reader</h2>
        <p class="d-none d-md-block">From timeless classics to the latest releases — find the perfect book and settle in.</p>
        <a href="/books" class="btn btn-light btn-lg mt-2"><i class="bi bi-search"></i> Explore the collection</a>
      </div>
    </div>
    <div class="carousel-item" data-bs-interval="5000">
      <img src="/public/assets/hero-nook.jpg" class="d-block w-100 carousel-img" alt="Quiet reading nook by a window surrounded by bookshelves">
      <div class="carousel-caption text-start">
        <h2 class="fw-bold">Borrowing made effortless</h2>
        <p class="d-none d-md-block">Add books to your cart, check out in seconds, and track everything from your profile.</p>
        <% if (!user) { %>
          <a href="/register" class="btn btn-light btn-lg mt-2"><i class="bi bi-person-plus"></i> Join the library</a>
        <% } else { %>
          <a href="/inventory/<%= user.id %>" class="btn btn-light btn-lg mt-2"><i class="bi bi-journal-bookmark"></i> My borrowed books</a>
        <% } %>
      </div>
    </div>
    <div class="carousel-item" data-bs-interval="5000">
      <img src="/public/assets/hero-study.jpg" class="d-block w-100 carousel-img" alt="Warm brick-walled study with bookshelves and plants by a window">
      <div class="carousel-caption text-start">
        <h2 class="fw-bold">Read more, worry less</h2>
        <p class="d-none d-md-block">Build a wishlist, reserve titles, and get a friendly reminder before anything's due.</p>
        <% if (user) { %>
          <a href="/wishlist" class="btn btn-light btn-lg mt-2"><i class="bi bi-heart"></i> View your wishlist</a>
        <% } else { %>
          <a href="/books" class="btn btn-light btn-lg mt-2"><i class="bi bi-collection"></i> Start browsing</a>
        <% } %>
      </div>
    </div>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#carouselCaptions" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselCaptions" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>

<!-- Main Content -->
<div class="bg-light">
  <div class="container my-4">
    <div class="row d-flex justify-content-center">
      <div class="col-md-11">
<%- include('partials/flash-toast') %>

        <!-- Popular Books -->
        <div class="card mb-3">
          <div class="card-body">
            <h2 class="display-6 fw-normal text-center mb-4">Popular Books</h2>
            <% if (typeof popularBooks !== 'undefined' && popularBooks.length > 0) { %>
              <div class="row slider mx-4">
                <% popularBooks.forEach(p => { %>
                  <div>
                    <%- include('partials/book-card', { book: p.book, rating: ratings[p.book.id], prevUrl: '/', footer: 'Borrowed ' + p.count + ' time(s)' }) %>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-center">Looks like there is nothing popular...</p>
            <% } %>
          </div>
        </div>

        <!-- Recently Added Books -->
        <div class="card m-0">
          <div class="card-body">
            <h2 class="display-6 fw-normal text-center my-4">Recently Added Books</h2>
            <% if (typeof recentBooks !== 'undefined' && recentBooks.length > 0) { %>
              <div class="row d-flex justify-content-center">
                <% recentBooks.forEach(book => { %>
                  <div class="col-lg-2 col-md-4 col-sm-6 col-xs-3 my-2" style="width: 11.5rem;">
                    <%- include('partials/book-card', { book: book, rating: ratings[book.id], prevUrl: '/' }) %>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-center">Looks like there are no books yet...</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>