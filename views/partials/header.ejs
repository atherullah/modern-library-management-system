<style>
  .main-navbar {
    background: #c0392b;
    padding: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    position: sticky;
    top: 0;
    z-index: 1030;
  }

  .main-navbar .navbar-brand {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: #fff !important;
    padding: 14px 0;
  }

  .main-navbar .navbar-brand span {
    color: #ffd700;
  }

  .main-navbar .nav-link {
    color: rgba(255,255,255,0.88) !important;
    font-weight: 500;
    padding: 18px 14px !important;
    font-size: 0.92rem;
    transition: color 0.2s, background 0.2s;
    border-bottom: 3px solid transparent;
  }

  .main-navbar .nav-link:hover,
  .main-navbar .nav-link.active {
    color: #fff !important;
    border-bottom-color: #ffd700;
    background: rgba(255,255,255,0.08);
  }

  .main-navbar .dropdown-menu {
    border: none;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    border-radius: 8px;
    padding: 8px 0;
    margin-top: 0;
  }

  .main-navbar .dropdown-item {
    padding: 8px 20px;
    font-size: 0.9rem;
    color: #333;
    transition: background 0.15s;
  }

  .main-navbar .dropdown-item:hover {
    background: #fef3f2;
    color: #c0392b;
  }

  .main-navbar .search-form {
    position: relative;
  }

  .main-navbar .search-input {
    border-radius: 20px;
    border: none;
    padding: 7px 16px 7px 36px;
    font-size: 0.88rem;
    width: 200px;
    background: rgba(255,255,255,0.15);
    color: #fff;
    transition: width 0.3s, background 0.3s;
  }

  .main-navbar .search-input::placeholder { color: rgba(255,255,255,0.65); }
  .main-navbar .search-input:focus {
    width: 260px;
    background: rgba(255,255,255,0.95);
    color: #333;
    outline: none;
    box-shadow: none;
  }
  .main-navbar .search-input:focus::placeholder { color: #aaa; }

  .main-navbar .search-icon {
    position: absolute;
    left: 11px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255,255,255,0.7);
    font-size: 0.85rem;
    pointer-events: none;
  }

  .main-navbar .search-input:focus ~ .search-icon { color: #aaa; }

  .main-navbar .badge-pill {
    font-size: 0.65rem;
    padding: 2px 5px;
    border-radius: 10px;
    vertical-align: super;
    margin-left: 2px;
  }

  .main-navbar .btn-admin {
    background: #ffd700;
    color: #333 !important;
    border-radius: 20px;
    padding: 6px 16px !important;
    font-weight: 700;
    font-size: 0.85rem;
    border-bottom: none !important;
    margin: auto 0;
  }

  .main-navbar .btn-admin:hover {
    background: #ffe033;
    border-bottom: none !important;
  }

  .main-navbar .user-avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255,255,255,0.5);
    margin-right: 6px;
  }

  [data-theme="dark"] .main-navbar { background: #1a1a2e; }
  [data-theme="dark"] .main-navbar .dropdown-menu { background: #16213e; border: 1px solid #2a2a4a; }
  [data-theme="dark"] .main-navbar .dropdown-item { color: #e0e0e0; }
  [data-theme="dark"] .main-navbar .dropdown-item:hover { background: #2a2a4a; color: #fff; }
</style>

<nav class="navbar navbar-expand-lg main-navbar">
  <div class="container-fluid px-4">

    <!-- Brand -->
    <a class="navbar-brand" href="/">📚 My<span>Library</span></a>

    <!-- Mobile toggle -->
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <!-- Left links -->
      <ul class="navbar-nav me-auto align-items-lg-stretch">
        <li class="nav-item">
          <a class="nav-link" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/books">Books</a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Genres
          </a>
          <ul class="dropdown-menu">
            <% genres.forEach((genre, i) => { %>
              <li><a class="dropdown-item" href="/genre-<%= i+1 %>"><%= genre %></a></li>
            <% }) %>
          </ul>
        </li>
        <% if (user && user.role !== 0) { %>
          <li class="nav-item">
            <a class="nav-link" href="/cart">
              🛒 Cart
              <% if (typeof itemCount !== 'undefined' && itemCount > 0) { %>
                <span class="badge bg-warning text-dark badge-pill"><%= itemCount %></span>
              <% } %>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/wishlist">
              ♡ Wishlist
              <% if (typeof wishlistCount !== 'undefined' && wishlistCount > 0) { %>
                <span class="badge bg-warning text-dark badge-pill"><%= wishlistCount %></span>
              <% } %>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/inventory/<%= user.id %>">📦 Inventory</a>
          </li>
        <% } %>
      </ul>

      <!-- Search -->
      <form action="/search" method="GET" class="search-form d-flex align-items-center me-3 my-2 my-lg-0">
        <i class="bi bi-search search-icon"></i>
        <input type="text" name="title" class="search-input" placeholder="Search books...">
      </form>

      <!-- Right: auth / user -->
      <ul class="navbar-nav align-items-lg-center gap-1">
        <!-- Dark mode toggle -->
        <li class="nav-item">
          <button id="darkModeToggle" class="btn btn-sm btn-outline-light border-0 nav-link" title="Toggle dark mode" style="padding:14px 10px !important;">
            <i class="bi bi-moon-fill"></i>
          </button>
        </li>

        <% if (!user) { %>
          <li class="nav-item">
            <a class="nav-link" href="/login">Login</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/register">Register</a>
          </li>
        <% } else if (user.role === 0) { %>
          <!-- Admin -->
          <li class="nav-item">
            <a class="nav-link btn-admin" href="/admin">⚙ Admin Panel</a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <% if (user.googleAvatar) { %>
                <img src="<%= user.googleAvatar %>" class="user-avatar" alt="avatar">
              <% } %>
              <%= user.name.split(' ')[0] %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/logout">🚪 Logout</a></li>
            </ul>
          </li>
        <% } else { %>
          <!-- Customer -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <% if (user.googleAvatar) { %>
                <img src="<%= user.googleAvatar %>" class="user-avatar" alt="avatar">
              <% } %>
              <%= user.name.split(' ')[0] %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/profile">👤 My Profile</a></li>
              <li><a class="dropdown-item" href="/history/<%= user.id %>">📖 Borrow History</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" href="/logout">🚪 Logout</a></li>
            </ul>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
