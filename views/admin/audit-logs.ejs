<div class="container-fluid">
  <div class="row flex-nowrap">
    <%- include('../partials/admin-sidebar') %>
    <div class="col py-3">
      <div class="col overflow-auto h-100">
        <div class="bg-light border rounded-3 p-3">
          <h2 class="display-5 mb-3">🔍 Audit Logs</h2>

          <% if (msg && msg.length > 0) { %>
            <div class="alert alert-info alert-dismissible fade show" role="alert">
              <%= msg %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% } %>

          <!-- Filters -->
          <form method="GET" action="/admin/audit-logs" class="row g-2 mb-4">
            <div class="col-md-3">
              <select name="action" class="form-select form-select-sm">
                <option value="">All Actions</option>
                <% actions.forEach(a => { %>
                  <option value="<%= a %>" <%= query.action === a ? 'selected' : '' %>><%= a %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-3">
              <input type="text" name="admin" class="form-control form-control-sm"
                placeholder="Filter by admin name" value="<%= query.admin || '' %>">
            </div>
            <div class="col-md-2">
              <input type="date" name="from" class="form-control form-control-sm" value="<%= query.from || '' %>">
            </div>
            <div class="col-md-2">
              <input type="date" name="to" class="form-control form-control-sm" value="<%= query.to || '' %>">
            </div>
            <div class="col-md-2 d-flex gap-2">
              <button type="submit" class="btn btn-sm btn-primary">Filter</button>
              <a href="/admin/audit-logs" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
          </form>

          <% if (logs.length === 0) { %>
            <div class="alert alert-secondary">No audit logs found.</div>
          <% } else { %>
            <p class="text-muted small mb-2">Showing <%= logs.length %> most recent entries</p>
            <div class="table-responsive">
              <table class="table table-hover table-sm align-middle">
                <thead class="table-dark">
                  <tr>
                    <th>Timestamp</th>
                    <th>Admin</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Description</th>
                    <th>IP</th>
                  </tr>
                </thead>
                <tbody>
                  <% logs.forEach(log => { %>
                    <tr>
                      <td class="text-nowrap small text-muted">
                        <%= new Date(log.created_at).toLocaleString() %>
                      </td>
                      <td class="fw-bold small"><%= log.admin_name %></td>
                      <td>
                        <%
                          const badgeMap = {
                            ADD_BOOK: 'bg-success',
                            UPDATE_BOOK: 'bg-primary',
                            DELETE_BOOK: 'bg-danger',
                            IMPORT_BOOKS: 'bg-info text-dark',
                            MARK_FINE_PAID: 'bg-warning text-dark',
                            UPDATE_SETTINGS: 'bg-secondary',
                          }
                          const badge = badgeMap[log.action] || 'bg-dark'
                        %>
                        <span class="badge <%= badge %>"><%= log.action %></span>
                      </td>
                      <td class="small"><%= log.entity || '—' %></td>
                      <td class="small"><%= log.description || '—' %></td>
                      <td class="small text-muted"><%= log.ip || '—' %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
