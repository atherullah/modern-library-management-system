<div class="container-fluid">
  <div class="row flex-nowrap">
    <%- include('../partials/admin-sidebar') %>
    <div class="col py-3">
      <div class="col overflow-auto h-100">
        <div class="bg-light border rounded-3 p-3">
          <h2 class="mb-3 display-4">Edit Book</h2>
          <form method="POST" action="/admin/book?_method=PUT" enctype="multipart/form-data">
            <input type="hidden" name="id" value="<%= book.id %>">
            <input type="hidden" name="oldISBN" value="<%= book.oldISBN || book.isbn %>">
            <div class="mb-3">
              <label for="isbn" class="form-label">ISBN</label>
              <div class="input-group">
                <input type="text" class="form-control" id="isbn" name="isbn" value="<%= book.isbn %>" required>
                <button type="button" class="btn btn-outline-secondary" onclick="openScanner()" title="Scan barcode">
                  <i class="bi bi-upc-scan"></i> Scan
                </button>
                <button type="button" class="btn btn-outline-primary" onclick="lookupISBN()" title="Auto-fill from ISBN">
                  <i class="bi bi-search"></i> Lookup
                </button>
              </div>
              <div class="form-text">Scan a barcode or enter ISBN manually, then click Lookup to auto-fill book details.</div>
              <% if (typeof errors !== 'undefined') { %>
                <% errors.forEach(err => { %>
                  <% if (err.param === 'isbn') { %>
                    <p class="text-danger fw-bold mb-0"><%= err.msg %></p>
                  <% } %>
                <% }) %>
              <% } %>
            </div>
            <div class="mb-3">
              <label for="title" class="form-label">Title</label>
              <input type="text" class="form-control" id="title" name="title" value="<%= book.title %>" required >
            </div>
            <div class="mb-3">
              <label for="author" class="form-label">Author</label>
              <input type="text" class="form-control" name="author" value="<%= book.author %>" required>
            </div>
            <div class="mb-3">
              <label for="publish_year" class="form-label">Publish Year</label>
              <input type="text" class="form-control" name="publish_year" value="<%= book.publish_year %>" required>
              <% if (typeof errors !== 'undefined') { %>
                <% errors.forEach(err => { %>
                  <% if (err.param === 'publish_year') { %>
                    <p class="text-danger fw-bold mb-0"><%= err.msg %></p>
                  <% } %>
                <% }) %>
              <% } %>
            </div>
            <div class="mb-3">
              <label for="page_count" class="form-label">Page Count</label>
              <input type="number" class="form-control" name="page_count" min="1" value="<%= book.page_count %>" required>
            </div>
            <div class="mb-3">
              <label for="categories" class="form-label">Categories (Hold Ctrl/Cmd to select multiple)</label>
              <select class="form-select" name="categories" multiple required size="5">
                <% genres.forEach(genre => { %>
                  <option value="<%= genre %>" <%= (book.categories && book.categories.includes(genre)) ? 'selected' : '' %>><%= genre %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label for="description" class="form-label">Description</label>
              <textarea class="form-control" name="description" rows="5"><%= book.description %></textarea>
            </div>
            <div class="mb-3">
              <label for="stock" class="form-label">Stock</label>
              <input type="number" class="form-control" name="stock" min="0" value="<%= book.stock %>" required>
            </div>
            <div class="mb-3">
              <label for="image-preview" class="form-label">Image Preview</label><br>
              <img class="image-preview" src="<%= book.coverImagePath %>" alt="image-preview" width="150" height="200">
            </div>
            <div class="mb-3">
              <label for="cover_image" class="form-label">Cover Image</label>
              <input class="form-control" type="file" id="cover_image" name="cover_image">
            </div>
            <div class="float-end mb-5">
              <a href="/admin/book" class="btn btn-secondary">Back to book list</a>
              <button type="submit" class="btn btn-primary" onsubmit="preventDefault()">Update Book</button>
            </div>
            <br>
            <br>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@zxing/browser@0.1.5/umd/zxing-browser.min.js"></script>

<!-- Barcode Scanner Modal -->
<div class="modal fade" id="scannerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-upc-scan"></i> Scan Book Barcode</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" onclick="stopScanner()"></button>
      </div>
      <div class="modal-body text-center">
        <p class="text-muted small mb-2">Point your camera at the book's barcode (ISBN)</p>
        <video id="scanner-video" style="width:100%;border-radius:8px;"></video>
        <div id="scan-result" class="mt-2 text-success fw-bold"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="stopScanner()">Cancel</button>
      </div>
    </div>
  </div>
</div>

<script>
  const cover_image = document.querySelector('#cover_image')
  const imagePreview = document.querySelector('.image-preview')

  cover_image.addEventListener('change', () => {
    const url = URL.createObjectURL(cover_image.files[0])
    imagePreview.src = url
  });

  let scannerControls = null

  async function openScanner() {
    if (typeof ZXingBrowser === 'undefined') {
      alert('Barcode scanner library failed to load. Please check your connection and try again.')
      return
    }
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      alert('Camera access requires a secure context (https:// or http://localhost).')
      return
    }

    const modalEl = document.getElementById('scannerModal')
    const resultEl = document.getElementById('scan-result')
    resultEl.textContent = ''
    resultEl.className = 'mt-2 text-success fw-bold'
    new bootstrap.Modal(modalEl).show()

    const codeReader = new ZXingBrowser.BrowserMultiFormatReader()
    try {
      scannerControls = await codeReader.decodeFromConstraints(
        { video: { facingMode: 'environment' } },
        'scanner-video',
        (result, err, controls) => {
          scannerControls = controls
          if (result) {
            const isbn = result.getText()
            document.getElementById('isbn').value = isbn
            resultEl.textContent = '✓ Scanned: ' + isbn
            stopScanner()
            bootstrap.Modal.getInstance(modalEl).hide()
            setTimeout(lookupISBN, 300)
          }
          if (err && err.name && err.name !== 'NotFoundException') {
            console.warn('[Scanner]', err)
          }
        }
      )
    } catch (err) {
      console.error('[Scanner] Camera error:', err)
      resultEl.textContent = '⚠ Camera error: ' + (err && err.message ? err.message : err)
      resultEl.className = 'mt-2 text-danger fw-bold'
    }
  }

  function stopScanner() {
    if (scannerControls) {
      scannerControls.stop()
      scannerControls = null
    }
  }

  function notify(msg, type) {
    if (window.showToast) window.showToast(msg, type || 'info')
    else alert(msg)
  }

  function setField(name, val) {
    const el = document.querySelector(`[name="${name}"]`)
    if (el && val != null && String(val).trim() !== '') el.value = val
  }

  function yearFrom(s) {
    const m = String(s || '').match(/(\d{4})/)
    return m ? m[1] : ''
  }

  function autoSelectCategories(subjects) {
    const select = document.querySelector('[name="categories"]')
    if (!select || !subjects || !subjects.length) return
    const hay = subjects.join(' | ').toLowerCase()
    Array.from(select.options).forEach(opt => {
      if (hay.includes(opt.value.toLowerCase())) opt.selected = true
    })
  }

  async function attachCover(url, isbn) {
    try {
      const resp = await fetch(url)
      if (!resp.ok) return false
      const blob = await resp.blob()
      if (!blob.type.startsWith('image/') || blob.size < 1500) return false
      const ext = blob.type.includes('png') ? 'png' : 'jpg'
      const file = new File([blob], `cover_${isbn}.${ext}`, { type: blob.type })
      const input = document.getElementById('cover_image')
      const dt = new DataTransfer()
      dt.items.add(file)
      input.files = dt.files
      input.dispatchEvent(new Event('change'))
      return true
    } catch (err) {
      console.warn('[Cover] auto-fetch failed (CORS/network):', err)
      return false
    }
  }

  async function lookupISBN() {
    const isbn = document.getElementById('isbn').value.trim().replace(/[-\s]/g, '')
    if (!isbn) return notify('Please enter or scan an ISBN first.', 'warning')

    const btn = document.querySelector('button[onclick="lookupISBN()"]')
    const original = btn.innerHTML
    btn.disabled = true
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Looking up...'

    const info = { title: '', author: '', publish_year: '', page_count: '', description: '', subjects: [] }
    let coverUrl = ''

    try {
      try {
        const res = await fetch(`https://openlibrary.org/api/books?bibkeys=ISBN:${isbn}&format=json&jscmd=data`)
        const data = await res.json()
        const b = data[`ISBN:${isbn}`]
        if (b) {
          info.title = b.subtitle ? `${b.title}: ${b.subtitle}` : (b.title || '')
          info.author = (b.authors || []).map(a => a.name).join(', ')
          info.publish_year = yearFrom(b.publish_date)
          info.page_count = b.number_of_pages || ''
          info.description = b.notes ? (typeof b.notes === 'string' ? b.notes : (b.notes.value || '')) : ''
          info.subjects = (b.subjects || []).map(s => s.name)
          if (b.cover) coverUrl = b.cover.large || b.cover.medium || b.cover.small || ''
        }
      } catch (e) { console.warn('[Lookup] Open Library failed:', e) }

      if (!info.title || !info.author || !info.description || !info.subjects.length || !info.page_count || !coverUrl) {
        try {
          const gres = await fetch(`https://www.googleapis.com/books/v1/volumes?q=isbn:${isbn}&country=US`)
          if (gres.ok) {
            const gdata = await gres.json()
            const v = gdata.items && gdata.items[0] && gdata.items[0].volumeInfo
            if (v) {
              info.title = info.title || (v.subtitle ? `${v.title}: ${v.subtitle}` : (v.title || ''))
              info.author = info.author || (v.authors || []).join(', ')
              info.publish_year = info.publish_year || yearFrom(v.publishedDate)
              info.page_count = info.page_count || v.pageCount || ''
              info.description = info.description || v.description || ''
              if (!info.subjects.length) info.subjects = v.categories || []
              if (!coverUrl && v.imageLinks) {
                coverUrl = (v.imageLinks.thumbnail || v.imageLinks.smallThumbnail || '').replace(/^http:/, 'https:')
              }
            }
          }
        } catch (e) { console.warn('[Lookup] Google Books failed:', e) }
      }

      if (!info.title && !info.author) {
        notify('No details found for this ISBN on Open Library or Google Books. Please fill in manually.', 'warning')
        return
      }

      setField('title', info.title)
      setField('author', info.author)
      setField('publish_year', info.publish_year)
      setField('page_count', info.page_count)
      setField('description', info.description)
      autoSelectCategories(info.subjects)

      let coverMsg = ''
      if (coverUrl) {
        const ok = await attachCover(coverUrl, isbn)
        coverMsg = ok ? ' Cover image added.' : ' (Cover unavailable — keep the existing one or upload.)'
      }
      notify('Book details auto-filled.' + coverMsg, 'success')
    } catch (err) {
      console.error('[Lookup]', err)
      notify('Could not fetch book details. Please fill in manually.', 'danger')
    } finally {
      btn.disabled = false
      btn.innerHTML = original
    }
  }

  document.getElementById('scannerModal').addEventListener('hidden.bs.modal', stopScanner)
</script>