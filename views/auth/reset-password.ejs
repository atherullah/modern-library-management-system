<div class="container">
  <div class="row d-flex justify-content-center">
    <div class="col-10 col-sm-8 col-md-6 col-lg-5 m-5 p-4 bg-light border border-3">
      <h2 class="text-center mb-4">Reset Password</h2>
      <p class="text-center">Enter your new password below.</p>
      
      <div id="alert-messages" class="mt-3"></div>

      <form id="reset_password_form">
        <div class="mb-3">
          <label for="password" class="form-label">New Password</label>
          <input type="password" class="form-control" id="password" name="password" required autofocus>
          <p class="password error text-danger"></p>
        </div>
        <div class="mb-3">
          <label for="confirmPassword" class="form-label">Confirm New Password</label>
          <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required>
        </div>
        <div class="d-grid gap-2 col-8 mt-4 mx-auto text-center">
          <button type="submit" class="btn btn-primary" id="submitBtn">Reset Password</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const form = document.querySelector('#reset_password_form')
  const passwordError = document.querySelector('.password.error')
  const alertMessages = document.querySelector('#alert-messages')
  const submitBtn = document.querySelector('#submitBtn')

  form.addEventListener('submit', async (e) => {
    e.preventDefault()

    passwordError.textContent = ''
    alertMessages.innerHTML = ''
    submitBtn.disabled = true
    submitBtn.textContent = 'Saving...'

    const password = form.password.value
    const confirmPassword = form.confirmPassword.value

    try {
      // The token is passed from the server render context
      const token = '<%= token %>'
      
      const res = await fetch(`/reset-password/${token}`, {
        method: 'POST',
        body: JSON.stringify({ password, confirmPassword }),
        headers: { 'Content-Type': 'application/json' }
      })

      const data = await res.json()
      
      if (data.error) {
        passwordError.textContent = data.error
        submitBtn.disabled = false
        submitBtn.textContent = 'Reset Password'
      }
      
      if (data.success) {
        alertMessages.innerHTML = `<div class="alert alert-success">${data.message}</div>`
        form.reset()
        submitBtn.disabled = true
        setTimeout(() => {
          location.assign('/login')
        }, 3000)
      }
    } catch (err) {
      console.log(err)
      alertMessages.innerHTML = `<div class="alert alert-danger">An error occurred. Please try again later.</div>`
      submitBtn.disabled = false
      submitBtn.textContent = 'Reset Password'
    }
  });
</script>
