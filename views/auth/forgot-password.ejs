<div class="container">
  <div class="row d-flex justify-content-center">
    <div class="col-10 col-sm-8 col-md-6 col-lg-5 m-5 p-4 bg-light border border-3">
      <h2 class="text-center mb-4">Forgot Password</h2>
      <p class="text-center">Enter your email address to receive a password reset link.</p>
      
      <div id="alert-messages" class="mt-3"></div>

      <form id="forgot_password_form">
        <div class="mb-3">
          <label for="email" class="form-label">Email Address</label>
          <input type="email" class="form-control" id="email" name="email" required autofocus>
          <p class="email error text-danger"></p>
        </div>
        <div class="d-grid gap-2 col-8 mt-4 mx-auto text-center">
          <button type="submit" class="btn btn-primary" id="submitBtn">Send Reset Link</button>
          <div class="mt-3">Remembered your password? <a href="/login">Login now</a></div>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const form = document.querySelector('#forgot_password_form')
  const emailError = document.querySelector('.email.error')
  const alertMessages = document.querySelector('#alert-messages')
  const submitBtn = document.querySelector('#submitBtn')

  form.addEventListener('submit', async (e) => {
    e.preventDefault()

    emailError.textContent = ''
    alertMessages.innerHTML = ''
    submitBtn.disabled = true
    submitBtn.textContent = 'Sending...'

    const email = form.email.value

    try {
      const res = await fetch('/forgot-password', {
        method: 'POST',
        body: JSON.stringify({ email }),
        headers: { 'Content-Type': 'application/json' }
      })

      const data = await res.json()
      
      if (data.error) {
        emailError.textContent = data.error
        submitBtn.disabled = false
        submitBtn.textContent = 'Send Reset Link'
      }
      
      if (data.success) {
        alertMessages.innerHTML = `<div class="alert alert-success">${data.message}</div>`
        form.reset()
        submitBtn.disabled = false
        submitBtn.textContent = 'Send Reset Link'
      }
    } catch (err) {
      console.log(err)
      alertMessages.innerHTML = `<div class="alert alert-danger">An error occurred. Please try again later.</div>`
      submitBtn.disabled = false
      submitBtn.textContent = 'Send Reset Link'
    }
  });
</script>
